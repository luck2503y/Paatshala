# Paatshala Mobile Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file or publish secrets to git.

# Clerk Publishable Key (Get from Clerk Dashboard -> API Keys -> Publishable key)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Paatshala Secure Node.js Backend URL
EXPO_PUBLIC_BACKEND_URL=http://localhost:5000
