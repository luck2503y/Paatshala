{
  "expo": {
    "name": "Paatshala",
    "slug": "paatshala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paatshala.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Paatshala to save images to your photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow Paatshala to save images to your photos."
      }
    },
    "android": {
      "package": "com.paatshala.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07090E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "41ad269b-cc9b-4570-94b2-97bd44d739fb"
      }
    },
    "owner": "lucky2503",
    "plugins": [
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Paatshala to save photos to your library.",
          "savePhotosPermission": "Allow Paatshala to save photos to your library."
        }
      ]
    ]
  }
}
