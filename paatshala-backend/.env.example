# Paatshala Backend Service Environment Configuration
# Copy this file to .env and insert your real keys.
# NEVER commit .env to git or expose secrets publicly.

# Server Port
PORT=5000
NODE_ENV=development

# Clerk Backend Configuration (from Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Strict Two-User Allowlist (from Clerk Dashboard -> Users -> User ID)
# Exact Clerk User ID for Administrator (Participant A)
ADMIN_CLERK_USER_ID=user_2xxxxxxxxxxxxxxxxxxxxxxxxx
# Exact Clerk User ID for Friend (Participant D)
FRIEND_CLERK_USER_ID=user_2yyyyyyyyyyyyyyyyyyyyyyyyy

# Firebase Admin Service Account Credentials (from Firebase Console -> Project Settings -> Service Accounts)
# Path to service account JSON file, or inline JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# Firebase Project ID
FIREBASE_PROJECT_ID=paatshala-app
